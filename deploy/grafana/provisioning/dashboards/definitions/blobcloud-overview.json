        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(blobcloud_worker_job_errors_total[1m])) by (job_type)",
          "legendFormat": "Errors ({{job_type}})",
          "refId": "B"
        }
      ],
      "title": "SQS Worker Job Execution Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
