# ==============================================================================
# Blob-Cloud Production Environment Configuration Template
# Copy this file to .env on your production host and populate with real secrets.
# ==============================================================================

# --- Application Server ---
ENV=production
PORT=8090
BASE_URL=https://blobcloud.dev
APP_BASE_URL=https://blobcloud.dev

# --- PostgreSQL Database (e.g. AWS RDS PostgreSQL 16) ---
DB_DSN=postgres://postgres:<DB_PASSWORD>@<RDS_HOSTNAME>:5432/blobcloud?sslmode=require
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# --- Redis Backplane & Distributed Rate Limiting ---
# Inside Docker network use redis://redis:6379; on standalone host use redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379

# --- Storage Provider (AWS S3) ---
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=blobxcloud
# If using EC2 IAM Role, leave AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY empty.
# Otherwise provide static IAM user credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom endpoint (e.g. Cloudflare R2 / MinIO):
AWS_S3_ENDPOINT=
# Optional CloudFront CDN distribution domain:
CLOUDFRONT_DOMAIN=

# --- Asynchronous Queue & Compute Plane (Amazon SQS) ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/blob-cloud-uploads
SQS_NUM_WORKERS=3
SQS_POLL_TIMEOUT_SEC=20
# Set to false if running standalone worker container (cmd/worker) or AWS Lambda
ENABLE_INPROCESS_WORKER=false

# --- Authentication & WebSockets ---
JWT_SECRET=generate-a-secure-random-32-byte-hex-string-here
WS_CORS_ORIGINS=https://blobcloud.dev,http://localhost:5173

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=<YOUR_CLIENT_ID>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<YOUR_CLIENT_ID>.apps.googleusercontent.com

# --- AI Intelligence (Google Gemini API) ---
GEMINI_API_KEY=

# --- Transactional Email (Resend or SMTP) ---
RESEND_API_KEY=
EMAIL_FROM=BlobCloud <noreply@blobcloud.dev>
# Fallback SMTP settings if RESEND_API_KEY is unset:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Distributed Token Bucket Rate Limits (requests per minute) ---
RL_AUTH_RPM=10
RL_UPLOAD_RPM=30
RL_API_RPM=120
